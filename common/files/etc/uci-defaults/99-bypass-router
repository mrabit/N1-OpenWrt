#!/bin/sh

# N1 bypass-router defaults. The uci-defaults runner removes this file after success.

set -u

service_enable_if_present() {
	service="$1"
	[ -x "/etc/init.d/$service" ] || return 0
	"/etc/init.d/$service" enable >/dev/null 2>&1 || true
}

service_restart_if_present() {
	service="$1"
	[ -x "/etc/init.d/$service" ] || return 0
	"/etc/init.d/$service" restart >/dev/null 2>&1 || true
}

if [ -f /etc/config/network ]; then
	uci -q set network.lan.gateway='192.168.0.1'
	uci -q set network.lan.delegate='0'
	uci -q set network.lan.peerdns='0'
	uci -q delete network.lan.dns
	uci -q add_list network.lan.dns='192.168.0.1'
	uci -q add_list network.lan.dns='223.5.5.5'
	uci -q add_list network.lan.dns='119.29.29.29'
	uci -q commit network
fi

# Point the resolver at the netifd-generated upstream list (192.168.0.1 / 223.5.5.5 /
# 119.29.29.29) rather than the stock 127.0.0.1 stub. In bypass-router mode nothing
# serves 127.0.0.1:53 at boot (dnsmasq is off, no AdGuardHome yet), so self-resolution
# and apk would otherwise fail. The auto file lives on tmpfs and netifd rebuilds it from
# network.lan.dns each boot; this symlink lives on the btrfs root and persists. If the
# auto file is not present yet the link is momentarily dangling and self-heals once
# netifd brings up lan.
ln -sf /tmp/resolv.conf.d/resolv.conf.auto /etc/resolv.conf

if [ -f /etc/config/dhcp ]; then
	uci -q set dhcp.lan.dhcpv4='disabled'
	uci -q set dhcp.lan.dhcpv6='disabled'
	uci -q set dhcp.lan.ra='disabled'
	uci -q set dhcp.@dnsmasq[0].dns_redirect='0'
	# port=0: dnsmasq stops listening on :53 entirely, so AdGuardHome can bind it.
	# Even if PassWall pulls dnsmasq back up it won't take :53 (runbook §3).
	uci -q set dhcp.@dnsmasq[0].port='0'
	uci -q delete dhcp.@dnsmasq[0].server
	uci -q add_list dhcp.@dnsmasq[0].server='223.5.5.5'
	uci -q add_list dhcp.@dnsmasq[0].server='119.29.29.29'
	uci -q commit dhcp
fi

if [ -f /etc/config/firewall ]; then
	uci -q set firewall.@zone[0].input='ACCEPT'
	uci -q set firewall.@zone[0].output='ACCEPT'
	uci -q set firewall.@zone[0].forward='ACCEPT'
	# 单臂旁路由 lan zone masq：按设备区分（实测 2026-08）。
	# N1 必须开 masq=1，否则国内直连站点访问不了；x86/armvirt 必须关，
	# 开了反而访问不了。用 /etc/config/amlogic 判定 N1（仅 N1 有）。
	if [ -f /etc/config/amlogic ]; then
		uci -q set firewall.@zone[0].masq='1'
	else
		uci -q set firewall.@zone[0].masq='0'
	fi
	uci -q set firewall.@defaults[0].flow_offloading='1'
	uci -q set firewall.@defaults[0].flow_offloading_hw='0'
	uci -q set firewall.@defaults[0].fullcone='0'
	uci -q set firewall.@defaults[0].fullcone6='0'

	uci -q commit firewall
fi

# EasyTier 跨区转发：预设插件自己的 et_forward，让 easytier 管理防火墙转发规则，而不是
# 我们手工建 firewall.forwarding。luci-app-easytier 自带的 /etc/config/easytier 默认
# auto_config_firewall='1' 但 et_forward 为空 —— 它的 init.d(set_firewall)只建 EasyTier
# zone(masq)+tun0 accept，两个跨区 forwarding 都不建。预设 'etfwlan lanfwet' 后，用户在
# LuCI 配好组网、enabled='1' 时,set_firewall 按 et_forward 建两条具名规则:
#   etfwlan → EasyTier→lan：easytier 节点访问本机 LAN 设备(如 192.168.0.5:22)。缺这条时
#             ping 通(icmp 走 easytier 用户态栈)但 tcp 建连被 forward 链 drop(实测 2026-08)。
#   lanfwet → lan→EasyTier：局域网机器经本机访问 easytier 代理子网(如 192.168.4.0/24)。
# 规则生命周期完全由插件接管(每次启动按 et_forward set/删同名 section)，故这里只设值、不建
# firewall 规则,避免和插件重复;LuCI 的 Access Control 也会显示成已勾选,界面自洽。enabled=0
# (未配组网)时 easytier 不启动、无 EasyTier zone,本就不需要规则,故无"空窗期"损失。
if [ -f /etc/config/easytier ]; then
	uci -q set easytier.@easytier[0].et_forward='etfwlan lanfwet'
	uci -q commit easytier
fi

sed -i '/^net.ipv4.ip_forward=/d' /etc/sysctl.conf 2>/dev/null || true
printf '%s\n' 'net.ipv4.ip_forward=1' >> /etc/sysctl.conf
sysctl -p >/dev/null 2>&1 || true

# NTP 服务器不在此设: 会被 ImmortalWrt 的 99-default-settings-chinese
# (排在本脚本之后) 覆盖成它的 CN 列表。详见 CLAUDE.md。
if [ -f /etc/config/system ]; then
	uci -q set system.@system[0].zonename='Asia/Shanghai'
	uci -q set system.@system[0].timezone='CST-8'
	uci -q commit system
fi

# luci-app-amlogic (晶晨宝盒): OTA source + board settings. ophub's `remake` packaging
# step unconditionally overlays its own /etc/config/amlogic (repo -> ophub official,
# btrfs, schedutil) on top of our rootfs (remake line ~914, `cp -af common-files/.`),
# so a static files/etc/config/amlogic never survives into the image. Re-assert our
# values here at first boot — which runs *after* that packaging overlay — so they win.
# NOTE: amlogic_firmware_repo must be a PUBLIC repo. amlogic_check_firmware.sh fetches
# the releases HTML anonymously with bare curl (no token support), so a private repo
# 404s and OTA never sees an update.
if [ -f /etc/config/amlogic ]; then
	uci -q set amlogic.config=amlogic
	uci -q set amlogic.config.enable='1'
	uci -q set amlogic.config.amlogic_firmware_repo='https://github.com/mrabit/N1-OpenWrt'
	uci -q set amlogic.config.amlogic_firmware_tag='OpenWrt'
	uci -q set amlogic.config.amlogic_firmware_suffix='.img.gz'
	uci -q set amlogic.config.amlogic_kernel_path='https://github.com/ophub/kernel'
	uci -q set amlogic.config.amlogic_kernel_tags='kernel_stable'
	uci -q set amlogic.config.amlogic_kernel_branch='6.12'
	uci -q set amlogic.config.amlogic_firmware_config='1'
	uci -q set amlogic.config.amlogic_write_bootloader='1'
	uci -q set amlogic.config.amlogic_shared_fstype='ext4'
	uci -q set amlogic.armcpu=settings
	uci -q set amlogic.armcpu.governor0='performance'
	uci -q set amlogic.armcpu.minfreq0='1512000'
	uci -q set amlogic.armcpu.maxfreq0='1512000'
	uci -q commit amlogic
fi

# PassWall: default config + baked-in node + shunt settings (runbook §5). The node
# (socks://192.168.0.8:1180) is per-deployment data baked in by request.
if [ -f /usr/share/passwall/0_default_config ] && [ ! -s /etc/config/passwall ]; then
	cp -f /usr/share/passwall/0_default_config /etc/config/passwall
fi
if [ -f /etc/config/passwall ]; then
	uci -q set passwall.node8socks=nodes
	uci -q set passwall.node8socks.type='Socks'
	uci -q set passwall.node8socks.remarks='Macmini'
	uci -q set passwall.node8socks.address='192.168.0.8'
	uci -q set passwall.node8socks.port='1180'
	uci -q set passwall.@global[0].enabled='1'
	uci -q set passwall.@global[0].tcp_node='node8socks'
	uci -q set passwall.@global[0].udp_node='node8socks'
	uci -q set passwall.@global[0].dns_redirect='0'
	uci -q set passwall.@global[0].dns_shunt='chinadns-ng'
	uci -q set passwall.@global[0].dns_mode='tcp'
	uci -q set passwall.@global[0].use_default_dns='direct'
	# 国内(直连)DNS：新版字段名是 direct_dns，旧的 china_dns 已废弃(app.sh 不再读)。
	uci -q set passwall.@global[0].direct_dns='223.5.5.5:53'
	uci -q set passwall.@global[0].localhost_proxy='1'
	uci -q set passwall.@global[0].use_ipv6='0'
	uci -q set passwall.@global[0].filter_proxy_ipv6='1'
	# 代理模式 = GFW 列表：仅命中 GFW 列表的域名走代理，其余（含国内）直连。
	# 对应 LuCI「切换模式」的 GFW List 按钮 (switch_gfw_mode): use_gfw_list=1 +
	# chn_list=0 + tcp/udp_proxy_mode=disable。这四项运行时都从 @global[0] 读取
	# (app.sh: config_t_get global …)，写到 @global_forwarding[0] 不生效。
	uci -q set passwall.@global[0].use_gfw_list='1'
	uci -q set passwall.@global[0].chn_list='0'
	uci -q set passwall.@global[0].tcp_proxy_mode='disable'
	uci -q set passwall.@global[0].udp_proxy_mode='disable'
	uci -q set passwall.@global_forwarding[0].ipv6_tproxy='0'
	uci -q set passwall.@global_forwarding[0].accept_icmpv6='0'
	uci -q set passwall.@global_forwarding[0].udp_proxy_drop_ports='443'
	uci -q set passwall.@global_forwarding[0].udp_redir_ports='1:65535'
	uci -q set passwall.@global_forwarding[0].tcp_redir_ports='22,25,53,80,143,443,465,587,853,873,993,995,5222,8080,8443,9418'
	uci -q commit passwall
fi

# AdGuardHome: enable + point at the baked-in yaml (upstream -> chinadns-ng:15353,
# filters/rewrites baked in by request; schema_version must match the built AGH).
if [ -f /etc/config/adguardhome ]; then
	uci -q set adguardhome.config.enabled='1'
	uci -q commit adguardhome
	chown -R adguardhome:adguardhome /etc/adguardhome 2>/dev/null || true
fi

# SNMP: restrict read-only community to the LAN (default 'default' is world-readable).
if [ -f /etc/config/snmpd ]; then
	uci -q set snmpd.public.source='192.168.0.0/24'
	uci -q commit snmpd
fi

# KMS (vlmcsd): enable the activation server. auto_activate stays 0 — dnsmasq is off,
# enabling it would write a config into /tmp/dnsmasq.d for a stopped daemon.
if [ -f /etc/config/vlmcsd ]; then
	uci -q set vlmcsd.config.enabled='1'
	uci -q commit vlmcsd
fi

# dnsmasq: stop + disable. Bypass mode hands :53 to AdGuardHome; port=0 (above) also
# keeps it from re-binding :53 if PassWall pulls it back up.
if [ -x /etc/init.d/dnsmasq ]; then
	/etc/init.d/dnsmasq stop >/dev/null 2>&1 || true
	/etc/init.d/dnsmasq disable >/dev/null 2>&1 || true
fi

service_enable_if_present firewall
service_enable_if_present sysntpd
service_enable_if_present snmpd
service_enable_if_present vlmcsd
service_enable_if_present passwall
service_enable_if_present adguardhome

# restart order matters: passwall (chinadns-ng:15353) must be up before adguardhome
# (whose upstream points at 15353).
service_restart_if_present firewall
service_restart_if_present sysntpd
service_restart_if_present snmpd
service_restart_if_present vlmcsd
service_restart_if_present passwall
service_restart_if_present adguardhome

exit 0
