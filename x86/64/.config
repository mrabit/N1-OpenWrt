# x86/64 (generic) target + rootfs + arch-specific packages.
# Shared service stack + common userland live in common/config.services, appended
# by the build lib / workflow before `make defconfig`.
#
# NOTE: `make defconfig` is authoritative — it may flip dependent symbols. After a
# first build, re-check the effective .config if a symbol below did not stick.

CONFIG_TARGET_x86=y
CONFIG_TARGET_x86_64=y
CONFIG_TARGET_x86_64_DEVICE_generic=y

# Image: EFI combined (squashfs), gzip-compressed -> *-generic-squashfs-combined-efi.img.gz.
# BIOS combined disabled — modern UEFI hosts/VMs only.
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_GRUB_EFI_IMAGES=y
# CONFIG_GRUB_IMAGES is not set
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_INITRAMFS=n
CONFIG_TARGET_ROOTFS_CPIOGZ=n
CONFIG_TARGET_ROOTFS_TARGZ=n
# rootfs partition size (MiB). Default 160 is too small for the bundled service
# stack (PassWall + xray/sing-box + AdGuardHome + luci) -> ext4 image build fails
# with "out of space". 1024 matches the N1 ophub rootfs size; the ext4 partition
# in the combined image grows to fit and squashfs+overlay use the remainder.
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# necessary (ext4 combined partition tooling + userland parity with N1)
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_bsdtar=y
CONFIG_PACKAGE_chattr=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_getopt=y
CONFIG_PACKAGE_lsattr=y
CONFIG_PACKAGE_pigz=y
CONFIG_PACKAGE_tar=y

# kmod: common x86 NICs (bare metal + virtualization)
CONFIG_PACKAGE_kmod-e1000=y
CONFIG_PACKAGE_kmod-e1000e=y
CONFIG_PACKAGE_kmod-igb=y
CONFIG_PACKAGE_kmod-igc=y
CONFIG_PACKAGE_kmod-r8169=y
CONFIG_PACKAGE_kmod-vmxnet3=y
CONFIG_PACKAGE_kmod-virtio-net=y

# other packages
CONFIG_PACKAGE_partx-utils=n
CONFIG_PACKAGE_shellsync=n
