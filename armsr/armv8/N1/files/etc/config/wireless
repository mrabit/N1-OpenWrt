# N1 (BCM43455) 预置无线: 开放 AP "N1-OpenWrt" 桥进 lan (br-lan)。
# 仅 N1 profile 生效 (armsr/armv8/N1/files 叠加在 common/files 之上); x86 不含此文件。
#
# 设计要点:
# - 预置完整 wireless => 首boot 不再自动生成那个 "启用的开放 ImmortalWrt AP"
#   (FullMAC 不能 AP+STA, 那个垃圾 AP 会占 radio; 见 CLAUDE.md)。
# - path 为 N1 SDIO 硬件路径 (真机 uci 与 /sys 读回一致); phy 重编号不影响, 按路径绑定。
# - 只放 AP, 不放 STA: STA 段会带家用 WiFi 明文密码, 绝不入 git。要用 STA 客户端
#   自行在 LuCI 添加 (记得删/禁 AP, FullMAC 二选一), roamoff=1 已由 modprobe.d 兜底。
# - 开放 AP 桥进 192.168.0.0/24: 覆盖内任何设备免密接入内网, 自行评估风险。

config wifi-device 'radio0'
	option type 'mac80211'
	option path 'platform/soc/d0000000.apb/d0070000.mmc/mmc_host/mmc0/mmc0:0001/mmc0:0001:1'
	option band '2g'
	option channel '1'
	option country 'CN'
	option cell_density '0'

config wifi-iface 'apnet'
	option device 'radio0'
	option mode 'ap'
	option ssid 'N1-OpenWrt'
	option encryption 'none'
	option network 'lan'
