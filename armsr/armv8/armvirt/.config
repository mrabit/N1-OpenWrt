# armsr/armv8 generic ARM VM (armvirt) target + rootfs + arch-specific packages.
# Shared service stack + common userland live in common/config.services, appended
# by the build lib / workflow before `make defconfig`.
#
# This profile targets ARM64 virtual machines (UTM / QEMU on Apple Silicon, and
# any EDK2/UEFI aarch64 hypervisor). "armvirt" is the ARM-community name for such
# an image (also an OpenWrt legacy target name). Unlike N1 (same armsr/armv8
# target) it does NOT go through ophub: armsr already emits a bootable EFI combined
# image, exactly like x86/64. So it mirrors the x86 profile, dropping the
# amlogic/ophub/on-board-WiFi machinery (virtio is builtin — see below).
#
# VERIFIED via `make defconfig` on the armsr/armv8 tree (2026.08):
#   (A) all GRUB/rootfs symbols below survive defconfig unchanged
#       (CONFIG_GRUB_EFI_IMAGES=y, SQUASHFS+EXT4+GZIP kept) — same symbol names as x86.
#   (B) virtio (BLK/NET/CONSOLE/PCI/MMIO) is builtin (=y) in the armsr 6.12 kernel,
#       so there are NO kmod-virtio-* packages to select and root mounts with no
#       initramfs (see the virtio note below).
#   (C) the produced image is immortalwrt-armsr-armv8-generic-squashfs-combined-efi.img.gz,
#       matching the `*squashfs-combined-efi.img.gz` glob the build scripts collect
#       (confirmed against the x86 tree's identical efi-default recipe output).
# `make defconfig` remains authoritative on future kernel bumps — re-check if a
# symbol stops sticking.

CONFIG_TARGET_armsr=y
CONFIG_TARGET_armsr_armv8=y
CONFIG_TARGET_armsr_armv8_DEVICE_generic=y

# Image: EFI combined (squashfs), gzip-compressed -> *-generic-squashfs-combined-efi.img.gz.
CONFIG_TARGET_ROOTFS_SQUASHFS=y
CONFIG_TARGET_ROOTFS_EXT4FS=y
CONFIG_GRUB_EFI_IMAGES=y
# CONFIG_GRUB_IMAGES is not set
CONFIG_TARGET_IMAGES_GZIP=y
CONFIG_TARGET_ROOTFS_INITRAMFS=n
CONFIG_TARGET_ROOTFS_CPIOGZ=n
CONFIG_TARGET_ROOTFS_TARGZ=n
# rootfs partition size (MiB). Default 160 is too small for the bundled service
# stack (PassWall + xray/sing-box + AdGuardHome + luci) -> ext4 image build fails
# with "out of space". 1024 matches the x86/N1 rootfs size.
CONFIG_TARGET_ROOTFS_PARTSIZE=1024

# necessary (ext4 combined partition tooling + userland parity with x86/N1)
CONFIG_PACKAGE_e2fsprogs=y
CONFIG_PACKAGE_kmod-fs-ext4=y
CONFIG_PACKAGE_kmod-fs-vfat=y
CONFIG_PACKAGE_bsdtar=y
CONFIG_PACKAGE_chattr=y
CONFIG_PACKAGE_gawk=y
CONFIG_PACKAGE_getopt=y
CONFIG_PACKAGE_lsattr=y
CONFIG_PACKAGE_pigz=y
CONFIG_PACKAGE_tar=y

# virtio: nothing to add here. VERIFIED against the armsr 6.12 kernel config
# (target/linux/armsr/config-6.12): VIRTIO, VIRTIO_BLK, VIRTIO_NET, VIRTIO_CONSOLE,
# VIRTIO_PCI and VIRTIO_MMIO are all builtin (=y) in the armsr kernel — armsr is a
# VM-first ARM SystemReady target. So there are no kmod-virtio-* packages to select
# (a `make defconfig` drops them); the combined-efi image boots virtio root/NIC with
# no initramfs. If a future kernel bump makes any of these modular, add the kmod here.

# arch-specific bits that don't apply to a generic VM (drop N1/board NIC drivers,
# amlogic OTA, and the ophub btrfs/xfs/f2fs repackaging tooling).
CONFIG_PACKAGE_partx-utils=n
CONFIG_PACKAGE_shellsync=n
